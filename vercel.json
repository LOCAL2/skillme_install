{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([cC]url|[wW]get|[pP]ower[sS]hell).*"
        }
      ],
      "destination": "/api/get"
    },
    { "source": "/install", "destination": "/api/get"
    },
    { "source": "/get",    "destination": "/api/get" },
    { "source": "/remove", "destination": "/api/remove" }
  ]
}
